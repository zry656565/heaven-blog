---
import "../styles/global.css";
import {
  defaultOgImage,
  fallbackSite,
  siteDescription,
  siteEmail,
  siteOwner,
  siteTitle,
} from "../lib/site";
import { absoluteUrl, plainText } from "../lib/text";

type Props = {
  title: string;
  description?: string | null;
  current?: "home" | "archive" | "about";
  type?: "website" | "article";
  publishedAt?: Date;
  image?: string | null;
  noindex?: boolean;
};

const {
  title,
  description = siteDescription,
  current,
  type = "website",
  publishedAt,
  image,
  noindex = false,
} = Astro.props;
const pageTitle =
  type === "article" || title !== siteTitle
    ? `${title} | ${siteTitle}`
    : siteTitle;
const metaDescription = plainText(description) || siteDescription;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site ?? fallbackSite);
const shareImage = image || defaultOgImage;
const ogImage = absoluteUrl(shareImage, Astro.site ?? fallbackSite);
const knownOgSize = shareImage === defaultOgImage;
const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: metaDescription,
        datePublished: publishedAt?.toISOString(),
        dateModified: publishedAt?.toISOString(),
        inLanguage: "zh-CN",
        mainEntityOfPage: canonical,
        image: ogImage,
        author: {
          "@type": "Person",
          name: siteOwner,
          email: siteEmail,
        },
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: siteTitle,
        description: siteDescription,
        url: absoluteUrl("/", Astro.site ?? fallbackSite),
        inLanguage: "zh-CN",
        author: {
          "@type": "Person",
          name: siteOwner,
          email: siteEmail,
        },
      };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content={siteOwner} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="咀嚼之味 RSS"
      href="/feed.xml"
    />
    <link rel="icon" href="/assets/images/favicon.ico" sizes="any" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      knownOgSize && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        var key = "theme";
        var stored = localStorage.getItem(key);
        var choice =
          stored === "light" || stored === "dark" || stored === "system"
            ? stored
            : "system";
        var resolved =
          choice === "system"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : choice;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themeChoice = choice;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">{siteTitle}</a>
        <nav class="site-nav" data-nav>
          <button
            class="menu-toggle"
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="site-menu">菜单</button
          >
          <div class="nav-links" id="site-menu">
            <a href="/" aria-current={current === "home" ? "page" : undefined}
              >首页</a
            >
            <a
              href="/all-articles/"
              aria-current={current === "archive" ? "page" : undefined}
              >所有文章</a
            >
            <a
              href="/about/"
              aria-current={current === "about" ? "page" : undefined}>关于</a
            >
            <a href="/feed.xml">RSS订阅</a>
          </div>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label="颜色主题：跟随系统"
          >
            <svg
              class="theme-icon"
              data-theme-icon="system"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"></circle>
              <path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor"></path>
            </svg>
            <svg
              class="theme-icon"
              data-theme-icon="light"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"></circle>
              <path
                d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"></path>
            </svg>
            <svg
              class="theme-icon"
              data-theme-icon="dark"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M15.2 4.1A8 8 0 1 0 19.9 15 6.4 6.4 0 0 1 15.2 4.1Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main class="wrap" id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-text">
          本站使用 <a href="https://astro.build">Astro</a>
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var labels = { system: "跟随系统", light: "浅色", dark: "深色" };
        var order = ["system", "light", "dark"];
        var root = document.documentElement;
        var button = document.querySelector("[data-theme-toggle]");
        var nav = document.querySelector("[data-nav]");
        var menu = document.querySelector("[data-menu-toggle]");

        function resolve(choice) {
          return choice === "system"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : choice;
        }

        function apply(choice) {
          root.dataset.themeChoice = choice;
          root.dataset.theme = resolve(choice);
          localStorage.setItem("theme", choice);
          if (button) {
            button.setAttribute("aria-label", "颜色主题：" + labels[choice]);
            button.setAttribute("title", labels[choice]);
          }
        }

        apply(root.dataset.themeChoice || "system");

        button &&
          button.addEventListener("click", function () {
            var current = root.dataset.themeChoice || "system";
            apply(order[(order.indexOf(current) + 1) % order.length]);
          });

        function setMenu(open) {
          if (!nav || !menu) return;
          nav.classList.toggle("is-open", open);
          menu.setAttribute("aria-expanded", open ? "true" : "false");
        }

        menu &&
          menu.addEventListener("click", function () {
            setMenu(!nav.classList.contains("is-open"));
          });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") setMenu(false);
        });

        matchMedia("(prefers-color-scheme: dark)").addEventListener(
          "change",
          function () {
            if ((root.dataset.themeChoice || "system") === "system") {
              apply("system");
            }
          },
        );
      })();
    </script>
  </body>
</html>
