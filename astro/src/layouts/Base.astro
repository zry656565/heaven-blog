---
import "../styles/global.css";
import {
  defaultOgImage,
  fallbackSite,
  siteDescription,
  siteEmail,
  siteOwner,
  siteTitle,
} from "../lib/site";
import { absoluteUrl, plainText } from "../lib/text";

type Props = {
  title: string;
  description?: string | null;
  current?: "home" | "archive" | "about";
  type?: "website" | "article";
  publishedAt?: Date;
  image?: string | null;
  noindex?: boolean;
};

const {
  title,
  description = siteDescription,
  current,
  type = "website",
  publishedAt,
  image,
  noindex = false,
} = Astro.props;
const pageTitle =
  type === "article" || title !== siteTitle
    ? `${title} | ${siteTitle}`
    : siteTitle;
const metaDescription = plainText(description) || siteDescription;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site ?? fallbackSite);
const shareImage = image || defaultOgImage;
const ogImage = absoluteUrl(shareImage, Astro.site ?? fallbackSite);
const knownOgSize = shareImage === defaultOgImage;
const currentYear = new Date().getFullYear();
const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: metaDescription,
        datePublished: publishedAt?.toISOString(),
        dateModified: publishedAt?.toISOString(),
        inLanguage: "zh-CN",
        mainEntityOfPage: canonical,
        image: ogImage,
        author: {
          "@type": "Person",
          name: siteOwner,
          email: siteEmail,
        },
      }
    : title === siteTitle
      ? {
          "@context": "https://schema.org",
          "@type": "WebSite",
          name: siteTitle,
          description: siteDescription,
          url: canonical,
          inLanguage: "zh-CN",
          author: {
            "@type": "Person",
            name: siteOwner,
            email: siteEmail,
          },
        }
      : {
          "@context": "https://schema.org",
          "@type": "WebPage",
          name: pageTitle,
          description: metaDescription,
          url: canonical,
          inLanguage: "zh-CN",
          isPartOf: {
            "@type": "WebSite",
            name: siteTitle,
            url: absoluteUrl("/", Astro.site ?? fallbackSite),
          },
        };
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <script is:inline>
      if (
        window.location.hostname === "jerryzou.com" ||
        window.location.hostname === "www.jerryzou.com"
      ) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", "G-QDS85ESC7N");

        var googleTag = document.createElement("script");
        googleTag.async = true;
        googleTag.src =
          "https://www.googletagmanager.com/gtag/js?id=G-QDS85ESC7N";
        document.head.appendChild(googleTag);
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content={siteOwner} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="咀嚼之味 RSS"
      href="/feed.xml"
    />
    <link rel="icon" href="/assets/images/favicon.ico" sizes="any" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      knownOgSize && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        var key = "theme";
        var stored;
        try {
          stored = localStorage.getItem(key);
        } catch (_error) {
          stored = null;
        }
        document.documentElement.dataset.theme =
          stored === "dark" ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">{siteTitle}</a>
        <nav class="site-nav" data-nav>
          <button
            class="menu-toggle"
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="site-menu">菜单</button
          >
          <div class="nav-links" id="site-menu">
            <a href="/" aria-current={current === "home" ? "page" : undefined}
              >首页</a
            >
            <a
              href="/all-articles/"
              aria-current={current === "archive" ? "page" : undefined}
              >所有文章</a
            >
            <a
              href="/about/"
              aria-current={current === "about" ? "page" : undefined}>关于</a
            >
            <a href="/feed.xml">RSS订阅</a>
          </div>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label="切换到深色模式"
          >
            <svg
              class="theme-icon"
              data-theme-icon="light"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"></circle>
              <path
                d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"></path>
            </svg>
            <svg
              class="theme-icon"
              data-theme-icon="dark"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M15.2 4.1A8 8 0 1 0 19.9 15 6.4 6.4 0 0 1 15.2 4.1Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main class="wrap" id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-text">© 2013–{currentYear} {siteOwner}</p>
        <nav class="footer-links" aria-label="页脚导航">
          <a href="/feed.xml">RSS 订阅</a>
          <span aria-hidden="true">·</span>
          <a href="/about/">关于我</a>
          <span aria-hidden="true">·</span>
          <a href={`mailto:${siteEmail}`}>联系我</a>
        </nav>
        <p class="footer-text">
          使用 <a href="https://astro.build">Astro</a> 构建，托管于 <a
            href="https://pages.cloudflare.com">Cloudflare Pages</a
          >
        </p>
        <p class="footer-text">本站使用 Google Analytics 了解整体访问情况</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var button = document.querySelector("[data-theme-toggle]");
        var nav = document.querySelector("[data-nav]");
        var menu = document.querySelector("[data-menu-toggle]");

        function apply(theme, persist) {
          root.dataset.theme = theme;
          if (persist) {
            try {
              localStorage.setItem("theme", theme);
            } catch (_error) {
              // Theme switching still works when storage is unavailable.
            }
          }
          if (button) {
            var label = theme === "dark" ? "切换到浅色模式" : "切换到深色模式";
            button.setAttribute("aria-label", label);
            button.setAttribute("title", label);
          }
        }

        apply(root.dataset.theme === "dark" ? "dark" : "light", false);

        button &&
          button.addEventListener("click", function () {
            apply(root.dataset.theme === "dark" ? "light" : "dark", true);
          });

        function setMenu(open) {
          if (!nav || !menu) return;
          nav.classList.toggle("is-open", open);
          menu.setAttribute("aria-expanded", open ? "true" : "false");
        }

        menu &&
          menu.addEventListener("click", function () {
            setMenu(!nav.classList.contains("is-open"));
          });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") setMenu(false);
        });
      })();
    </script>
  </body>
</html>
