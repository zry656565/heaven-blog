---
import { getCollection } from "astro:content";
import Comments from "../../components/Comments.astro";
import Base from "../../layouts/Base.astro";
import { siteEmail, siteOwner } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { post: entry.data },
  }));
}

const { post } = Astro.props;
const year = post.date.slice(0, 4);
---

<Base
  title={post.title}
  description={post.description}
  type="article"
  publishedAt={post.publishedAt}
>
  <article>
    <h1 class="page-title">{post.title}</h1>
    <p class="meta">
      <time datetime={post.publishedAt.toISOString()}>{post.date}</time>
      {
        post.labels.length > 0 && (
          <span class="post-tags"> · {post.labels.join(" · ")}</span>
        )
      }
    </p>
    <div class="prose" set:html={post.html} />
    <footer class="article-footer">
      <p class="article-copyright">
        本文的版权归作者 <a href={`mailto:${siteEmail}`}>{siteOwner}</a>
        {" "}所有，采用{" "}
        <a href="https://creativecommons.org/licenses/by-nc/3.0/"
          >Attribution-NonCommercial 3.0 License</a
        >。任何人可以进行转载、分享，但不可在未经允许的情况下用于商业用途；转载请注明出处。感谢配合！
      </p>
      <p class="article-exit">
        <a href={`/all-articles/#y${year}`}>
          <span class="year-mark">{year}</span> 年的文章
        </a>
      </p>
    </footer>
    <Comments path={post.permalink} />
  </article>
</Base>
