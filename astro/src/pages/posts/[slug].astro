---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { post: entry.data },
  }));
}

const { post } = Astro.props;
const year = post.date.slice(0, 4);
---

<Base
  title={post.title}
  description={post.description}
  type="article"
  publishedAt={post.publishedAt}
  image={post.shareImage}
>
  <article>
    <h1 class="page-title">{post.title}</h1>
    <p class="meta">
      <time datetime={post.publishedAt.toISOString()}>{post.date}</time>
      {
        post.labels.length > 0 && (
          <span class="post-tags"> · {post.labels.join(" · ")}</span>
        )
      }
    </p>
    <div class="prose" set:html={post.html} />
    <p class="article-exit">
      <a href={`/all-articles/#y${year}`}>
        <span class="year-mark">{year}</span> 年的文章
      </a>
    </p>
  </article>
</Base>
