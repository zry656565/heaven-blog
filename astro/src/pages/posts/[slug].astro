---
import Base from "../../layouts/Base.astro";
import { getPost, listPosts } from "../../lib/posts";

export function getStaticPaths() {
  return listPosts().map((post) => ({
    params: { slug: post.slug },
  }));
}

const post = getPost(Astro.params.slug as string);
if (!post) {
  throw new Error(`未找到文章：${Astro.params.slug}`);
}
const year = post.date.slice(0, 4);
---

<Base title={post.title} description={post.description}>
  <article>
    <h1 class="page-title">{post.title}</h1>
    <p class="meta">
      <time datetime={post.publishedAt.toISOString()}>{post.date}</time>
      {
        post.labels.length > 0 && (
          <>
            {" · "}
            {post.labels.join(" · ")}
          </>
        )
      }
    </p>
    <div class="prose" set:html={post.html} />
    <p class="article-exit">
      <a href={`/all-articles/#y${year}`}>{year} 年的文章</a>
    </p>
  </article>
</Base>
