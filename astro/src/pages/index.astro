---
import Base from "../layouts/Base.astro";
import { listPosts } from "../lib/posts";

const posts = listPosts();
---

<Base title="咀嚼之味" current="home">
  <ol class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={post.permalink}>{post.title}</a>
          <time datetime={post.date}>{post.date}</time>
        </li>
      ))
    }
  </ol>
</Base>
