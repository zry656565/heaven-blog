---
import Base from "../layouts/Base.astro";
import { listPosts } from "../lib/posts";

const posts = listPosts().slice(0, 8);

function excerpt(text: string | null): string {
  return (text ?? "")
    .replace(/[*_`]+/g, "")
    .replace(/\s+/g, " ")
    .trim();
}
---

<Base title="咀嚼之味" current="home">
  <p class="lede">
    用语音和文字理解世界，做困难而有价值的事，珍惜人与人之间真诚的双向付出。
  </p>
  <ol class="post-list">
    {
      posts.map((post) => (
        <li>
          <time datetime={post.publishedAt.toISOString()}>{post.date}</time>
          <a href={post.permalink}>{post.title}</a>
          {excerpt(post.description) && (
            <p class="excerpt">{excerpt(post.description)}</p>
          )}
          {post.labels.length > 0 && (
            <p class="post-tags">{post.labels.join(" · ")}</p>
          )}
        </li>
      ))
    }
  </ol>
</Base>
