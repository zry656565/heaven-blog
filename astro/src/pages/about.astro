---
import Base from "../layouts/Base.astro";
import { imageMarkup, prepareResponsiveImages } from "../lib/images";

await prepareResponsiveImages();
const monkey = imageMarkup("/assets/images/monkey-transparent.png", {
  className: "monkey-avatar",
  alt: "",
  sizes: "6.5rem",
});

type TimelineItem = {
  when: string;
  name: string;
  title: string;
  href?: string;
};

const work: TimelineItem[] = [
  {
    when: "2021 – 至今",
    name: "航木科技",
    title: "HR Head，曾任 IT Head",
    href: "https://www.sailingwood.com.cn",
  },
  {
    when: "2018 – 2020",
    name: "力扣科技",
    title: "技术负责人",
  },
  {
    when: "2017",
    name: "Teambition",
    title: "前端工程师",
  },
  {
    when: "2015",
    name: "淘票票",
    title: "实习工程师",
  },
  {
    when: "2014",
    name: "Microsoft",
    title: "实习工程师",
  },
];

const school: TimelineItem[] = [
  {
    when: "2010 – 2017",
    name: "上海交通大学",
    title: "软件工程",
  },
];
---

<Base title="关于我" current="about">
  <h1 class="page-title">关于我</h1>
  <div class="about">
    <p>
      你们好，我是邹润阳，是一个写了十多年代码的程序员，如今深耕人事工作，对创造一家生机勃勃的公司充满好奇。如果你有任何问题，欢迎邮件联系我：<a
        href="mailto:jerry.zry@outlook.com">jerry.zry@outlook.com</a
      >。
    </p>
    <p>
      让我感到幸福的，通常是理解了一件新事物，完成了困难而有价值的事，或我关心的人因我的付出而感到幸福。健康、终身学习、有意义的关系和创造真实价值，是我愿意长期投入的事情。
    </p>
    <p class="about-inline">
      <a href="https://github.com/zry656565">GitHub</a>
      <a href="https://www.douban.com/people/jerry_zou/">豆瓣</a>
      <a href="https://x.com/JerryDDG">X</a>
    </p>
    <Fragment set:html={monkey} />
    <h2>工作</h2>
    <ol class="timeline">
      {
        work.map((item) => (
          <li>
            <span class="timeline-when">{item.when}</span>
            <span>
              {item.href ? <a href={item.href}>{item.name}</a> : item.name}
              <span class="timeline-title"> · {item.title}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <h2>求学</h2>
    <ol class="timeline">
      {
        school.map((item) => (
          <li>
            <span class="timeline-when">{item.when}</span>
            <span>
              {item.href ? <a href={item.href}>{item.name}</a> : item.name}
              <span class="timeline-title"> · {item.title}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <h2>友情链接</h2>
    <p class="about-inline">
      <a href="https://xidui.github.io/links/">xidui</a>
      <a href="https://szhshp.org/friends">szhshp</a>
      <a href="https://www.dozer.cc/about.html">Dozer</a>
      <a href="https://h1z3y3.me/links/">h1z3y3</a>
    </p>
  </div>
</Base>
