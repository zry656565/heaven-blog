---
type Props = {
  path: string;
};

const { path } = Astro.props;
const envId = import.meta.env.PUBLIC_TWIKOO_ENV_ID?.trim();
const region = import.meta.env.PUBLIC_TWIKOO_REGION?.trim();
const enabled = Boolean(envId);
---

<section
  class="comments"
  aria-labelledby="comments-title"
  data-twikoo-comments
  data-twikoo-enabled={String(enabled)}
  data-comment-path={path}
  data-env-id={envId}
  data-region={region}
>
  <h2 id="comments-title">评论</h2>
  {
    enabled ? (
      <>
        <p class="comments-status" role="status" data-comments-status>
          评论区正在加载…
        </p>
        <div id="tcomment" data-comments-mount />
        <noscript>
          <p class="comments-status">
            需要启用 JavaScript 才能查看和发表评论。
          </p>
        </noscript>
      </>
    ) : (
      <p class="comments-status">评论区尚未配置，正文阅读不受影响。</p>
    )
  }
  <script>
    (async function () {
      var section = document.querySelector<HTMLElement>(
        "[data-twikoo-comments]",
      );
      if (!section || section.dataset.twikooEnabled !== "true") return;

      var status = section.querySelector<HTMLElement>("[data-comments-status]");
      var mount = section.querySelector<HTMLElement>("[data-comments-mount]");

      function fail() {
        if (status) {
          status.hidden = false;
          status.textContent = "评论区暂时无法加载，请稍后刷新重试。";
        }
      }

      try {
        // Twikoo does not publish TypeScript declarations.
        // @ts-expect-error -- runtime shape is validated below.
        var module = await import("twikoo");
        var twikoo = module.default;
        if (!twikoo || !mount) throw new Error("Twikoo failed to load");

        var options: {
          envId: string;
          el: string;
          path: string;
          lang: string;
          region?: string;
        } = {
          envId: section.dataset.envId || "",
          el: "#tcomment",
          path: section.dataset.commentPath || location.pathname,
          lang: "zh-CN",
        };
        if (section.dataset.region) {
          options.region = section.dataset.region;
        }

        await twikoo.init(options);
        if (status) status.hidden = true;
      } catch (_error) {
        console.error("Twikoo initialization failed", _error);
        fail();
      }
    })();
  </script>
</section>
