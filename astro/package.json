{
  "name": "heaven-blog-astro",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node ../scripts/patch-twikoo-auth.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format:check": "prettier --check package.json astro.config.mjs tsconfig.json 'src/**/*.{astro,css}' 'scripts/**/*.mjs'",
    "check": "astro check",
    "test": "node --experimental-strip-types --no-warnings scripts/check-dates.ts && node scripts/check-built-site.mjs && node scripts/check-image-budget.mjs",
    "verify": "npm run format:check && npm run check && npm run build && npm run test"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.2.2",
    "marked": "^18.0.10",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "twikoo": "1.7.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
